{
  "template": "templates/赤石大桥_template_v2.docx",
  "output_dir": "outputs/_verify2",
  "source_report": "inputs/赤石大桥.docx",
  "bridge_data": {
    "enabled": true,
    "bridge_name": "赤石",
    "stats_dir": "preprocess/统计值/赤石",
    "charts_dir": "preprocess/图库/赤石",
    "sensor_map": "preprocess/统计值/传感器编号名称.json",
    "overview": "preprocess/统计值/赤石/总览.json",
    "name_dict": "preprocess/统计值/传感器名称对照/赤石大桥.json",
    "fuzzy_threshold": 0.7,
    "period_aggregate": true,
    "auto_fill_missing_charts": true,
    "metrics": {
      "temperature": {
        "feature": "WSD(temp)",
        "unit": "℃",
        "label": "环境温度"
      },
      "structure_temperature": {
        "feature": "WD(temp)",
        "unit": "℃",
        "label": "结构温度",
        "aliases": [
          "结构温度"
        ]
      },
      "humidity": {
        "feature": "WSD(rh)",
        "unit": "%",
        "label": "环境湿度"
      },
      "wind_speed": {
        "feature": "FSFX2(spfs)",
        "unit": "m/s",
        "label": "风速"
      },
      "cable_force": {
        "feature": "",
        "unit": "kN",
        "label": "索力"
      },
      "displacement": {
        "feature": "GNSS(Δx)",
        "unit": "mm",
        "label": "位移"
      },
      "deflection": {
        "feature": "",
        "unit": "mm",
        "label": "挠度"
      },
      "strain": {
        "feature": "YB(rsg)",
        "unit": "με",
        "label": "应变"
      },
      "vibration": {
        "feature": "",
        "unit": "m/s²",
        "label": "振动"
      },
      "rotation": {
        "feature": "EZJD(xJd)",
        "unit": "°",
        "label": "转角",
        "aliases": [
          "倾角"
        ]
      },
      "crack": {
        "feature": "LF(Δx)",
        "unit": "mm",
        "label": "裂缝"
      },
      "vehicle_count": {
        "feature": "",
        "unit": "辆",
        "label": "交通荷载"
      }
    },
    "sensor_exclude": [
      "210",
      "220"
    ],
    "sensor_aliases": {},
    "chart_map": {}
  },
  "report": {
    "name_prefix": "赤石大桥",
    "with_timestamp": false
  },
  "data": {
    "file": "data/temperature_daily.csv",
    "date_column": "date",
    "value_columns": [
      "temperature",
      "humidity"
    ],
    "thresholds": [
      30,
      35
    ],
    "strict_mode": false
  },
  "data_sources": {
    "temperature": {
      "file": "data/temperature_daily.csv",
      "date_column": "date",
      "value_columns": [
        "temperature"
      ],
      "label": "环境温度",
      "unit": "℃"
    },
    "humidity": {
      "file": "data/temperature_daily.csv",
      "date_column": "date",
      "value_columns": [
        "humidity"
      ],
      "label": "环境湿度",
      "unit": "%"
    },
    "cable_clamp": {
      "file": "data/cable_clamp.csv",
      "date_column": "date",
      "value_columns": [
        "h_87L_1",
        "h_87R_1",
        "h_88L_1",
        "h_88R_1",
        "h_87L_2",
        "h_87R_2",
        "h_88L_2",
        "h_88R_2"
      ],
      "label": "索夹滑动位移",
      "unit": "mm"
    },
    "rotation": {
      "file": "data/rotation.csv",
      "date_column": "date",
      "value_columns": [
        "m_junshan_x",
        "m_junshan_y",
        "m_yueyang_x",
        "m_yueyang_y"
      ],
      "label": "梁端转角",
      "unit": "°"
    },
    "wind_speed": {
      "file": "data/wind_speed.csv",
      "date_column": "date",
      "value_columns": [
        "j_junshan_top",
        "j_yueyang_top",
        "j_half_upstream",
        "j_half_downstream",
        "j_10min_avg"
      ],
      "label": "风速",
      "unit": "m/s"
    },
    "vehicle_count": {
      "file": "data/vehicle_count.csv",
      "date_column": "date",
      "value_columns": [
        "lane_1",
        "lane_2",
        "lane_3",
        "lane_4",
        "lane_5",
        "lane_6"
      ],
      "label": "交通荷载",
      "unit": "辆"
    }
  },
  "llm": {
    "enabled": true,
    "api_base": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key": "",
    "model": "qwen-plus",
    "review_low": 0.38,
    "review_high": 0.68,
    "timeout": 300,
    "batch_size": 20
  },
  "charts": {
    "engine": "python",
    "output_dir": "outputs/charts",
    "width_inches": 5.8,
    "definitions": [
      {
        "id": "trend",
        "type": "line",
        "title": "温度变化趋势（逐日）",
        "x_label": "日期",
        "y_label": "温度（℃）",
        "column": "temperature"
      },
      {
        "id": "histogram",
        "type": "histogram",
        "title": "温度分布直方图",
        "x_label": "温度（℃）",
        "y_label": "天数",
        "column": "temperature",
        "bins": 10
      }
    ],
    "matlab": {}
  },
  "schedule": {
    "mode": "quarterly",
    "weekday": 1,
    "day_of_month": 1,
    "hour": 8,
    "minute": 0,
    "use_apscheduler": true
  },
  "period": {
    "weekly_days": 7,
    "monthly_days": 30
  },
  "analysis_file": "outputs/analysis_赤石大桥.json"
}