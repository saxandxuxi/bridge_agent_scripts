[Unit]
Description=Data Analysis Report Agent (weekly/monthly scheduler)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/report-agent
ExecStart=/opt/report-agent/.venv/bin/python serve_scheduler.py
Restart=always
RestartSec=30
Environment=REPORT_AGENT_CONFIG=/opt/report-agent/config/config.json
Environment=TZ=Asia/Shanghai

[Install]
WantedBy=multi-user.target
