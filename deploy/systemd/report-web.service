[Unit]
Description=Data Analysis Report Agent Web Console
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/report-agent
ExecStart=/opt/report-agent/.venv/bin/python web/app.py
Restart=always
RestartSec=10
Environment=REPORT_WEB_HOST=127.0.0.1
Environment=REPORT_WEB_PORT=8080
Environment=REPORT_WEB_TOKEN=请改成随机令牌
Environment=REPORT_WEB_MODE=bridge
Environment=REPORT_PROJECT_ROOT=/opt/report-agent
Environment=TZ=Asia/Shanghai

[Install]
WantedBy=multi-user.target
